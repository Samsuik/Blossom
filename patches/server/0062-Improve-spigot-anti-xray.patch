diff --git a/src/main/java/me/samsuik/blossom/antixray/AntiXrayEngine.java b/src/main/java/me/samsuik/blossom/antixray/AntiXrayEngine.java
new file mode 100644
index 000000000..b8b7692b2
--- /dev/null
+++ b/src/main/java/me/samsuik/blossom/antixray/AntiXrayEngine.java
@@ -0,0 +1,141 @@
+package me.samsuik.blossom.antixray;
+
+import it.unimi.dsi.fastutil.ints.IntOpenHashSet;
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import net.minecraft.server.*;
+import org.spigotmc.AntiXray;
+
+import java.util.List;
+import java.util.Random;
+
+public abstract class AntiXrayEngine {
+    private static AntiXrayEngine instance;
+
+    public static AntiXrayEngine getEngine() {
+        return AntiXrayEngine.instance;
+    }
+
+    public static void setEngine(final AntiXrayEngine engine) {
+        AntiXrayEngine.instance = engine;
+    }
+
+    protected static final int[] NEIGHBOR_OFFSETS_R1;
+    protected static final int[] NEIGHBOR_OFFSETS_R2;
+
+    protected final Random random = new Random();
+    protected final int sections;
+    protected final List<Block> hiddenBlocks;
+    protected final List<Block> replaceBlocks;
+
+    private final LongOpenHashSet queuedUpdates = new LongOpenHashSet();
+
+    public AntiXrayEngine(final int sections, final List<Block> hiddenBlocks, final List<Block> replaceBlocks) {
+        this.sections = sections;
+        this.hiddenBlocks = hiddenBlocks;
+        this.replaceBlocks = replaceBlocks;
+    }
+
+    public abstract void obfuscate(
+        final int chunkX,
+        final int chunkZ,
+        final int bitmask,
+        final byte[] buffer,
+        final World world
+    );
+
+    public void flushUpdates(final World world) {
+        final BlockPosition.MutableBlockPosition mutablePos = new BlockPosition.MutableBlockPosition();
+        for (final long update : this.queuedUpdates) {
+            final int x = BlockPosition.getX(update);
+            final int y = BlockPosition.getY(update);
+            final int z = BlockPosition.getZ(update);
+
+            world.notify(mutablePos.setValues(x, y, z));
+        }
+
+        this.queuedUpdates.clear();
+    }
+
+    public void updateNearbyBlocks(final World world, final BlockPosition pos) {
+        this.updateNearbyBlocks(world, pos, false);
+    }
+
+    public void updateNearbyBlocks(final World world, final BlockPosition pos, final boolean player) {
+        if (!world.spigotConfig.antiXray) {
+            return;
+        }
+
+        for (final int offset : (player ? NEIGHBOR_OFFSETS_R2 : NEIGHBOR_OFFSETS_R1)) {
+            final int x = pos.getX() + x(offset);
+            final int y = pos.getY() + y(offset);
+            final int z = pos.getZ() + z(offset);
+
+            this.queuedUpdates.add(BlockPosition.asLong(x, y, z));
+        }
+    }
+
+    public final boolean isExposed(final World world, final BlockPosition pos) {
+        return this.isExposed(world, pos.getX(), pos.getY(), pos.getZ());
+    }
+
+    public final boolean isExposed(final World world, final int x, final int y, final int z) {
+        final BlockPosition.MutableBlockPosition mutablePos = new BlockPosition.MutableBlockPosition();
+        for (final int offset : NEIGHBOR_OFFSETS_R1) {
+            final int blockX = x + x(offset);
+            final int blockY = y + y(offset);
+            final int blockZ = z + z(offset);
+            mutablePos.setValues(blockX, blockY, blockZ);
+
+            if (!AntiXray.isSolidBlock(AntiXray.getType(world, mutablePos))) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    protected static int x(final int packed) {
+        return (packed << 28) >> 28;
+    }
+
+    protected static int y(final int packed) {
+        return (packed << 20) >> 28;
+    }
+
+    protected static int z(final int packed) {
+        return (packed << 12) >> 28;
+    }
+
+    protected static int packed(final int x, final int y, final int z) {
+        return (x & 0xf) | ((y & 0xf) << 8) | ((z & 0xf) << 16);
+    }
+
+    static {
+        final IntOpenHashSet r1 = new IntOpenHashSet();
+        final IntOpenHashSet r2 = new IntOpenHashSet();
+
+        for (final EnumDirection dir : EnumDirection.values()) {
+            for (final EnumDirection dir2 : EnumDirection.values()) {
+                final int x = dir.getAdjacentX() + dir2.getAdjacentX();
+                final int y = dir.getAdjacentY() + dir2.getAdjacentY();
+                final int z = dir.getAdjacentZ() + dir2.getAdjacentZ();
+
+                r2.add(packed(x, y, z));
+            }
+
+            final int x = dir.getAdjacentX();
+            final int y = dir.getAdjacentY();
+            final int z = dir.getAdjacentZ();
+            final int packed = packed(x, y, z);
+
+            r1.add(packed);
+            r2.add(packed);
+        }
+
+        r1.remove(0);
+        r2.remove(0);
+
+        NEIGHBOR_OFFSETS_R1 = r1.toArray(new int[0]);
+        NEIGHBOR_OFFSETS_R2 = r2.toArray(new int[0]);
+    }
+}
