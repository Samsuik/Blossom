diff --git a/src/main/java/me/samsuik/blossom/world/ScheduledBlock.java b/src/main/java/me/samsuik/blossom/world/ScheduledBlock.java
new file mode 100644
index 000000000..1ccb764cb
--- /dev/null
+++ b/src/main/java/me/samsuik/blossom/world/ScheduledBlock.java
@@ -0,0 +1,43 @@
+package me.samsuik.blossom.world;
+
+import it.unimi.dsi.fastutil.HashCommon;
+import net.minecraft.server.Block;
+import net.minecraft.server.BlockPosition;
+import net.minecraft.server.NextTickListEntry;
+
+import java.util.Objects;
+
+public final class ScheduledBlock {
+    private final Block type;
+    private final BlockPosition pos;
+    private final NextTickListEntry entry;
+
+    public ScheduledBlock(final NextTickListEntry entry) {
+        this.type = entry.e;
+        this.pos = entry.a;
+        this.entry = entry;
+    }
+
+    public BlockPosition getPosition() {
+        return this.pos;
+    }
+
+    public NextTickListEntry getEntry() {
+        return this.entry;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (!(o instanceof ScheduledBlock)) return false;
+
+        final ScheduledBlock that = (ScheduledBlock) o;
+        return Objects.equals(this.type, that.type) && Objects.equals(this.pos, that.pos);
+    }
+
+    @Override
+    public int hashCode() {
+        int result = HashCommon.mix(this.type.hashCode());
+        result = 31 * result + Long.hashCode(pos.asLong());
+        return result;
+    }
+}
diff --git a/src/main/java/me/samsuik/blossom/world/ScheduledBlockTicks.java b/src/main/java/me/samsuik/blossom/world/ScheduledBlockTicks.java
new file mode 100644
index 000000000..5d30178e8
--- /dev/null
+++ b/src/main/java/me/samsuik/blossom/world/ScheduledBlockTicks.java
@@ -0,0 +1,135 @@
+package me.samsuik.blossom.world;
+
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import net.minecraft.server.*;
+import org.bukkit.craftbukkit.util.LongHash;
+
+import java.util.*;
+
+public final class ScheduledBlockTicks extends AbstractSet<NextTickListEntry> {
+    private final HashSet<ScheduledBlock> scheduledBlocks = new HashSet<>();
+    private final TreeSet<NextTickListEntry> blocksToTick = new TreeSet<>();
+    private final Long2ObjectOpenHashMap<Set<ScheduledBlock>> chunkTickingBlocks = new Long2ObjectOpenHashMap<>();
+
+    @Override
+    public int size() {
+        return this.scheduledBlocks.size();
+    }
+
+    @Override
+    public boolean add(final NextTickListEntry entry) {
+        final ScheduledBlock scheduledBlock = new ScheduledBlock(entry);
+        if (!this.scheduledBlocks.add(scheduledBlock)) {
+            return false;
+        }
+
+        final int x = entry.a.getX() >> 4;
+        final int z = entry.a.getZ() >> 4;
+        final long chunkPos = LongHash.toLong(x, z);
+
+        this.chunkTickingBlocks.computeIfAbsent(chunkPos, pos -> new HashSet<>()).add(scheduledBlock);
+        this.blocksToTick.add(entry);
+
+        return true;
+    }
+
+    @Override
+    public boolean remove(final Object o) {
+        if (!(o instanceof NextTickListEntry)) return false;
+        final NextTickListEntry entry = (NextTickListEntry) o;
+
+        this.blocksToTick.remove(entry);
+        return this.removeEntry(entry);
+    }
+
+    private boolean removeEntry(final NextTickListEntry entry) {
+        final ScheduledBlock scheduledBlock = new ScheduledBlock(entry);
+
+        final int x = entry.a.getX() >> 4;
+        final int z = entry.a.getZ() >> 4;
+        final long chunkPos = LongHash.toLong(x, z);
+
+        final Set<ScheduledBlock> blocks = this.chunkTickingBlocks.get(chunkPos);
+        if (blocks != null) {
+            blocks.remove(scheduledBlock);
+
+            if (blocks.isEmpty()) {
+                this.chunkTickingBlocks.remove(chunkPos);
+            }
+        }
+
+        return this.scheduledBlocks.remove(new ScheduledBlock(entry));
+    }
+
+    @Override
+    public boolean contains(final Object o) {
+        return this.scheduledBlocks.contains(o);
+    }
+
+    public List<NextTickListEntry> collectScheduledBlocks(final StructureBoundingBox boundingBox) {
+        final List<NextTickListEntry> scheduledBlocks = new ArrayList<>();
+
+        final int minChunkX = boundingBox.a >> 4;
+        final int minChunkZ = boundingBox.c >> 4;
+        final int maxChunkX = boundingBox.d >> 4;
+        final int maxChunkZ = boundingBox.f >> 4;
+
+        for (int chunkX = minChunkX; chunkX <= maxChunkX; ++chunkX) {
+            for (int chunkZ = minChunkZ; chunkZ <= maxChunkZ; ++chunkZ) {
+                final long chunkPos = LongHash.toLong(chunkX, chunkZ);
+                final Set<ScheduledBlock> scheduledBlocksInChunk = this.chunkTickingBlocks.get(chunkPos);
+                if (scheduledBlocksInChunk == null) {
+                    continue;
+                }
+
+                for (final ScheduledBlock scheduledBlock : scheduledBlocksInChunk) {
+                    final BlockPosition pos = scheduledBlock.getPosition();
+
+                    if (pos.getX() >= boundingBox.a && pos.getX() < boundingBox.d && pos.getZ() >= boundingBox.c && pos.getZ() < boundingBox.f) {
+                        scheduledBlocks.add(scheduledBlock.getEntry());
+                    }
+                }
+            }
+        }
+
+        return scheduledBlocks;
+    }
+
+    @Override
+    public void clear() {
+        this.scheduledBlocks.clear();
+        this.blocksToTick.clear();
+        this.chunkTickingBlocks.clear();
+    }
+
+    @Override
+    public Iterator<NextTickListEntry> iterator() {
+        return new Iterator<NextTickListEntry>() {
+            private final Iterator<NextTickListEntry> it = ScheduledBlockTicks.this.blocksToTick.iterator();
+            private NextTickListEntry last;
+
+            @Override
+            public boolean hasNext() {
+                return this.it.hasNext();
+            }
+
+            @Override
+            public NextTickListEntry next() {
+                return this.last = it.next();
+            }
+
+            @Override
+            public void remove() {
+                final NextTickListEntry entry = this.last;
+                if (entry == null) {
+                    throw new IllegalStateException("No element to remove");
+                }
+
+                this.last = null;
+                this.it.remove();
+
+                ScheduledBlockTicks.this.removeEntry(entry);
+            }
+        };
+    }
+}
