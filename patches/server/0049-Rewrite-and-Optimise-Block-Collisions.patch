--- /dev/null
+++ b/src/main/java/me/samsuik/blossom/utils/SectionChunkCache.java
@@ -0,0 +1,57 @@
+package me.samsuik.blossom.utils;
+
+import net.minecraft.server.*;
+
+public final class SectionChunkCache {
+    private static final IBlockData AIR = Blocks.AIR.getBlockData();
+
+    private final Chunk[][] chunks;
+    private final int baseX, baseZ;
+
+    public SectionChunkCache(World world, AxisAlignedBB bb) {
+        this(world, bb, false);
+    }
+
+    public SectionChunkCache(World world, AxisAlignedBB bb, boolean loadChunks) {
+        int minChunkX = MathHelper.floor(bb.a) >> 4;
+        int minChunkZ = MathHelper.floor(bb.c) >> 4;
+        int maxChunkX = MathHelper.floor(bb.d) >> 4;
+        int maxChunkZ = MathHelper.floor(bb.f) >> 4;
+
+        this.chunks = new Chunk[maxChunkX - minChunkX + 1][maxChunkZ - minChunkZ + 1];
+        this.baseX = minChunkX;
+        this.baseZ = minChunkZ;
+
+        for (int chunkX = minChunkX; chunkX <= maxChunkX; ++chunkX) {
+            for (int chunkZ = minChunkZ; chunkZ <= maxChunkZ; ++chunkZ) {
+                Chunk chunk;
+                if (loadChunks) {
+                    chunk = ((ChunkProviderServer) world.N()).getChunkAt(chunkX, chunkZ);
+                } else {
+                    chunk = world.getChunkIfLoaded(chunkX, chunkZ);
+                }
+                this.chunks[chunkX - minChunkX][chunkZ - minChunkZ] = chunk;
+            }
+        }
+    }
+
+    public IBlockData getType(int x, int y, int z) {
+        if (y >= 0 && y <= 255) {
+            final ChunkSection section = this.getSection(x, y, z);
+            if (section != null) {
+                return section.getType(x & 15, y & 15, z & 15);
+            }
+        }
+        return AIR;
+    }
+
+    public char getRawUnsafe(int x, int y, int z) {
+        ChunkSection section = this.getSection(x, y, z);
+        return section != null ? section.getRaw(x & 15, y & 15, z & 15) : 0;
+    }
+
+    private ChunkSection getSection(int x, int y, int z) {
+        Chunk chunk = this.chunks[(x >> 4) - this.baseX][(z >> 4) - this.baseZ];
+        return chunk != null ? chunk.getSections()[y >> 4] : null;
+    }
+}
