index 000000000..f94c4d233
--- /dev/null
+++ b/src/main/java/me/samsuik/blossom/network/ImmediatePackets.java
@@ -0,0 +1,28 @@
+package me.samsuik.blossom.network;
+
+import net.minecraft.server.*;
+
+public final class ImmediatePackets {
+    public static boolean needToFlush(final Packet<?> packet) {
+        return packet instanceof PacketPlayOutKeepAlive
+            || packet instanceof PacketLoginOutDisconnect
+            || packet instanceof PacketPlayOutTransaction;
+    }
+
+    public static boolean immediatePacket(final NetworkManager connection, final Packet<?> packet) {
+        return connection.getProtocol() != EnumProtocol.PLAY
+            || needToFlush(packet)
+            || packet instanceof PacketPlayOutChat
+            || packet instanceof PacketPlayOutTabComplete
+            || packet instanceof PacketPlayOutTitle
+            || packet instanceof PacketPlayOutNamedSoundEffect
+            || packet instanceof PacketPlayOutWorldParticles
+            || packet instanceof PacketPlayOutPlayerInfo
+            || packet instanceof PacketPlayOutPlayerListHeaderFooter;
+    }
+
+    public static boolean sendImmediately(final NetworkManager networkManager, final Packet<?> packet) {
+        return immediatePacket(networkManager, packet)
+            || MinecraftServer.getServer().isMainThread() && networkManager.isPacketQueueEmpty();
+    }
+}
