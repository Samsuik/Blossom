diff --git a/src/main/java/me/samsuik/blossom/network/PacketLimitHandler.java b/src/main/java/me/samsuik/blossom/network/PacketLimitHandler.java
new file mode 100644
index 000000000..bb1e63acd
--- /dev/null
+++ b/src/main/java/me/samsuik/blossom/network/PacketLimitHandler.java
@@ -0,0 +1,94 @@
+package me.samsuik.blossom.network;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.SimpleChannelInboundHandler;
+
+import java.util.ArrayDeque;
+import java.util.concurrent.TimeUnit;
+
+public final class PacketLimitHandler extends SimpleChannelInboundHandler<ByteBuf> {
+    private static final long SAMPLE_LENGTH = TimeUnit.SECONDS.toMillis(1);
+
+    private final ArrayDeque<Sample> samples = new ArrayDeque<>();
+    private final PacketLimit packetLimit;
+    private final PacketLimit byteLimit;
+
+    private final int maxSamples;
+    private int packets, totalPackets;
+    private long bytes, totalBytes;
+    private long lastSampleTime;
+    private long counter;
+
+    public PacketLimitHandler(final int samples, final PacketLimit packetLimit, final PacketLimit byteLimit) {
+        super(false);
+
+        for (int count = 0; count < samples; count++) {
+            this.samples.addLast(new Sample(0, 0));
+        }
+
+        this.maxSamples = samples;
+        this.packetLimit = packetLimit;
+        this.byteLimit = byteLimit;
+    }
+
+    @Override
+    protected void channelRead0(final ChannelHandlerContext ctx, final ByteBuf msg) throws Exception {
+        if (++this.packets >= this.packetLimit.max) {
+            throw new PacketRateLimitException("Too many packets received (Packets: " + this.packets + ")");
+        }
+
+        if ((this.bytes += msg.readableBytes()) >= this.byteLimit.max) {
+            throw new PacketRateLimitException("Too many bytes received (Bytes: " + this.bytes + ")");
+        }
+
+        if ((++this.counter & 7) == 0 && this.updateSamples()) {
+            final int packetCount = this.totalPackets / this.maxSamples;
+            if (packetCount >= this.packetLimit.average) {
+                throw new PacketRateLimitException("Packet rate limit exceeded (Ps: " + packetCount + ")");
+            }
+
+            final long receivedByteCount = this.totalBytes / this.maxSamples;
+            if (receivedByteCount >= this.byteLimit.average) {
+                throw new PacketRateLimitException("Byte rate limit exceeded (Bytes: " + receivedByteCount + ")");
+            }
+        }
+
+        ctx.fireChannelRead(msg);
+    }
+
+    private boolean updateSamples() {
+        final long millis = System.currentTimeMillis();
+        if (millis - this.lastSampleTime < SAMPLE_LENGTH) {
+            return false;
+        }
+
+        this.lastSampleTime = millis;
+
+        final ArrayDeque<Sample> samples = this.samples;
+        final Sample removedSample = samples.pollLast();
+        this.samples.push(new Sample(this.packets, this.bytes));
+
+        if (removedSample != null) {
+            this.totalPackets -= removedSample.packets;
+            this.totalBytes -= removedSample.bytes;
+        }
+
+        this.totalPackets += this.packets;
+        this.totalBytes += this.bytes;
+        this.packets = 0;
+        this.bytes = 0;
+
+        return true;
+    }
+
+    private static final class Sample {
+        private final int packets;
+        private final long bytes;
+
+        private Sample(final int packets, final long bytes) {
+            this.packets = packets;
+            this.bytes = bytes;
+        }
+    }
+}
