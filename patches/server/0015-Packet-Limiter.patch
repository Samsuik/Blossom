         config.addDefault(path, def);
         return config.getString(path, config.getString(path));
     }
-    
+
+    public static boolean packetLimiter;
+    public static int packetSamples;
+    public static me.samsuik.blossom.network.PacketLimit packetLimit;
+    public static me.samsuik.blossom.network.PacketLimit byteLimit;
+    private static void PacketLimiter() {
+        if (version < 4) {
+            final int violations = config.getInt("packet-limiter.violations", Integer.MIN_VALUE);
+            if (violations != Integer.MIN_VALUE) {
+                set("packet-limiter.samples", violations);
+                set("packet-limit.violations", null);
+            }
+
+            final int threshold = config.getInt("packet-limiter.threshold", Integer.MIN_VALUE);
+            if (threshold != Integer.MIN_VALUE) {
+                set("packet-limiter.packets.average", threshold);
+                set("packet-limiter.threshold", null);
+            }
+
+            final int max = config.getInt("packet-limiter.max", Integer.MIN_VALUE);
+            if (max != Integer.MIN_VALUE) {
+                set("packet-limiter.packets.max", max);
+                set("packet-limiter.max-pps", null);
+            }
+        }
+
+        packetLimiter = getBoolean("packet-limiter.enabled", true);
+        packetSamples = Math.min(Math.max(getInt("packet-limiter.samples", 8), 1), 32);
+
+        packetLimit = new me.samsuik.blossom.network.PacketLimit(
+            getLong("packet-limiter.packets.average", 120),
+            getLong("packet-limiter.packets.max", 400)
+        );
+
+        byteLimit = new me.samsuik.blossom.network.PacketLimit(
+            getLong("packet-limiter.bytes.average", 65536), // 64 KB
+            getLong("packet-limiter.bytes.max", 131072)     // 128 KB
+        );
+    }
 }
