             final int blockY = MathHelper.floor(trackingEntity.locY);
             final int blockZ = MathHelper.floor(trackingEntity.locZ);
 
-            final long packed = BlockPosition.asLong(blockX, blockY, blockZ);
-            final int curr = trackingEntity.world.minimal.get(packed);
-            if (curr != Integer.MIN_VALUE) {
-                return curr == trackingEntity.getId();
-            } else {
-                trackingEntity.world.minimal.put(packed, trackingEntity.getId());
+            // Blossom start - optimise entity tracker
+            synchronized (trackingEntity.world.minimal) {
+                final long packed = BlockPosition.asLong(blockX, blockY, blockZ);
+                final int curr = trackingEntity.world.minimal.get(packed);
+                if (curr != Integer.MIN_VALUE) {
+                    return curr == trackingEntity.getId();
+                } else {
+                    trackingEntity.world.minimal.put(packed, trackingEntity.getId());
+                }
             }
+            // Blossom end - optimise entity tracker
         }
 
         return true;
