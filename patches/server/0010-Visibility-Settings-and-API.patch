+package me.samsuik.blossom.player.visibility;
+
+import me.samsuik.blossom.configuration.BlossomConfig;
+import me.samsuik.blossom.util.ModernMaterial;
+import me.samsuik.blossom.visuals.Visuals;
+import org.bukkit.Bukkit;
+import org.bukkit.ChatColor;
+import org.bukkit.entity.Player;
+import org.bukkit.event.inventory.InventoryClickEvent;
+import org.bukkit.inventory.Inventory;
+import org.bukkit.inventory.InventoryHolder;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.inventory.meta.ItemMeta;
+
+import java.util.EnumMap;
+import java.util.HashMap;
+import java.util.Map;
+
+public final class FPSGUI {
+    private static final FPSGUI FPS_GUI = new FPSGUI();
+
+    public static FPSGUI getInstance() {
+        return FPS_GUI;
+    }
+
+    private final EnumMap<Visuals.VisualType, FPSIcon> iconMap = new EnumMap<>(Visuals.VisualType.class);
+    private final Map<Integer, Visuals.VisualType>     slotMap = new HashMap<>();
+
+    private FPSGUI() {
+        FPSGUIIcons.register(this.iconMap);
+        this.iconMap.forEach((key, value) -> this.slotMap.put(value.slot, key));
+    }
+
+    public void onClick(final InventoryClickEvent event) {
+        if (event.isCancelled()) {
+            return;
+        }
+
+        final Inventory inventory = event.getClickedInventory();
+        if (inventory == null || !(inventory.getHolder() instanceof Holder)) {
+            return;
+        }
+
+        final int slot = event.getSlot();
+        final Visuals.VisualType setting = slotMap.get(slot);
+        if (setting != null) {
+            final Player player = (Player) event.getWhoClicked();
+            final Visuals visibility = player.getVisuals();
+            visibility.toggle(setting);
+
+            final FPSIcon icon = iconMap.get(setting);
+            inventory.setItem(slot, icon.getItemStack(player, setting));
+        }
+
+        event.setCancelled(true);
+    }
+
+    public void showTo(final Player player) {
+        player.openInventory(this.createInventory(player));
+    }
+
+    private Inventory createInventory(final Player player) {
+        final Inventory inventory = Bukkit.createInventory(new Holder(), 54, "FPS Menu");
+        for (int index = 0; index < inventory.getSize(); ++index) {
+            final int column = index % 9;
+            final int row    = (index + 1) / 9;
+
+            final ItemStack backgroundItem = this.background(column, row).createItem(1);
+            final ItemMeta meta = backgroundItem.getItemMeta();
+            meta.setDisplayName(ChatColor.GRAY + "");
+            backgroundItem.setItemMeta(meta);
+
+            inventory.setItem(index, backgroundItem);
+        }
+
+        this.iconMap.forEach((key, icon) -> inventory.setItem(icon.slot, icon.getItemStack(player, key)));
+        return inventory;
+    }
+
+    private ModernMaterial background(final int column, final int row) {
+        if (column < 1 || column > 7) {
+            return ModernMaterial.getMaterial("BLACK_STAINED_GLASS_PANE");
+        }
+
+        if ((column < 2 || column > 6) && (row == 1 || row == 4)) {
+            return ModernMaterial.getMaterial("WHITE_STAINED_GLASS_PANE");
+        }
+
+        if ((column < 3 || column > 5) && (row == 0 || row == 5)) {
+            return ModernMaterial.getMaterial("GRAY_STAINED_GLASS_PANE");
+        }
+
+        if ((column >= 3 && column <= 5) && (row > 0 && row < 5)
+            || (column == 2 || column == 6) && (row == 2 || row == 3)) {
+            return BlossomConfig.fpsSettingCenter; // centre part
+        }
+
+        return BlossomConfig.fpsSettingInnerRing;
+    }
+
+    static final class Holder implements InventoryHolder {
+        @Override
+        public Inventory getInventory() {
+            return null;
+        }
+    }
+}
