+package me.samsuik.blossom.commands.subcommands;
+
+import me.samsuik.blossom.commands.BaseCommand;
+import me.samsuik.blossom.player.visibility.FPSGUI;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+
+public final class FPSCommand extends BaseCommand {
+    public FPSCommand() {
+        super("fps");
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String label, final String[] args) {
+        if (!(sender instanceof Player)) {
+            return true;
+        } else if (!this.testPermission(sender)) {
+            return true;
+        }
+
+        FPSGUI.getInstance().showTo((Player) sender);
+        return true;
+    }
+}
