+package me.samsuik.blossom.player.visibility;
+
+import me.samsuik.blossom.visuals.Visuals;
+import org.bukkit.ChatColor;
+import org.bukkit.Material;
+import org.bukkit.entity.Player;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.inventory.meta.ItemMeta;
+
+public final class FPSIcon {
+    final Material material;
+    final ChatColor colour;
+    final int slot;
+
+    public FPSIcon(final Material material, final ChatColor colour, final int slot) {
+        this.material = material;
+        this.colour = colour;
+        this.slot = slot;
+    }
+
+    public ItemStack getItemStack(final Player player, final Visuals.VisualType setting) {
+        final Visuals visibility = player.getVisuals();
+
+        // Get the current state as a string
+        final String state = visibility.isEnabled(setting)
+            ? "Enabled" : "Disabled";
+
+        // Friendly name as a component
+        final ItemStack itemstack = new ItemStack(material);
+        final ItemMeta meta = itemstack.getItemMeta();
+
+        // Set the display name
+        meta.setDisplayName(colour + setting.getFriendlyName() + " " + ChatColor.GRAY + state);
+
+        itemstack.setItemMeta(meta);
+        return itemstack;
+    }
+}
diff --git a/src/main/java/me/samsuik/blossom/player/visibility/FilterSentPackets.java b/src/main/java/me/samsuik/blossom/player/visibility/FilterSentPackets.java
new file mode 100644
index 000000000..205219723
--- /dev/null
+++ b/src/main/java/me/samsuik/blossom/player/visibility/FilterSentPackets.java
@@ -0,0 +1,218 @@
+package me.samsuik.blossom.player.visibility;
+
+import me.samsuik.blossom.visuals.Visuals;
+import net.minecraft.server.*;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+public final class FilterSentPackets {
+    private static final IBlockData SPAWNER_CONVERSION_BLOCK = Blocks.IRON_BLOCK.getBlockData();
+
+    public static boolean shouldTrackPlayer(final Entity trackingEntity, final EntityPlayer player) {
+        if (player.visualSettings.isToggled(Visuals.VisualType.TNT_VISIBILITY) && trackingEntity instanceof EntityTNTPrimed 
+            || player.visualSettings.isToggled(Visuals.VisualType.SAND_VISIBILITY) && trackingEntity instanceof EntityFallingBlock) {
+            return false;
+        } else if (player.visualSettings.isToggled(Visuals.VisualType.MINIMAL) 
+            && (trackingEntity instanceof EntityTNTPrimed || trackingEntity instanceof EntityFallingBlock)) {
+            final int blockX = MathHelper.floor(trackingEntity.locX);
+            final int blockY = MathHelper.floor(trackingEntity.locY);
+            final int blockZ = MathHelper.floor(trackingEntity.locZ);
+
+            final long packed = BlockPosition.asLong(blockX, blockY, blockZ);
+            final int curr = trackingEntity.world.minimal.get(packed);
+            if (curr != Integer.MIN_VALUE) {
+                return curr == trackingEntity.getId();
+            } else {
+                trackingEntity.world.minimal.put(packed, trackingEntity.getId());
+            }
+        }
+
+        return true;
+    }
+
+    public static Packet<?> modifyPacket(final EntityPlayer player, final Packet<?> packet) {
+        final VisualSettings settings = player.visualSettings;
+        if (!settings.isModified()) {
+            return packet;
+        }
+
+        if (packet instanceof PacketPlayOutEntityEquipment && settings.isToggled(me.samsuik.blossom.visuals.Visuals.VisualType.ENCHANTMENT_GLINT)) {
+            final PacketPlayOutEntityEquipment eq = (PacketPlayOutEntityEquipment) packet;
+            ItemStack itemstack = eq.getItem();
+
+            if (itemstack != null && itemstack.hasEnchantments()) {
+                itemstack = itemstack.cloneItemStack();
+                itemstack.getTag().remove("ench");
+
+                return new PacketPlayOutEntityEquipment(eq.getId(), eq.getSlot(), itemstack);
+            }
+        } else if (packet instanceof PacketPlayOutBlockChange) {
+            final PacketPlayOutBlockChange bc = (PacketPlayOutBlockChange) packet;
+            if (!bc.dirtyUpdate) {
+                return packet;
+            }
+
+            final IBlockData modified = modifyBlockData(settings, bc.block);
+            if (modified == bc.block) {
+                // ignored
+            } else if (modified == null) {
+                return null;
+            } else {
+                return new PacketPlayOutBlockChange(modified, bc.getPosition());
+            }
+        } else if (packet instanceof PacketPlayOutMultiBlockChange) {
+            final PacketPlayOutMultiBlockChange bc = (PacketPlayOutMultiBlockChange) packet;
+            if (!bc.dirtyUpdate) {
+                return packet;
+            }
+
+            final PacketPlayOutMultiBlockChange.MultiBlockChangeInfo[] changeInfoArr = bc.getBlockChangeInfo();
+            List<PacketPlayOutMultiBlockChange.MultiBlockChangeInfo> changeInfoList = null;
+            int changes = 0;
+
+            for (int index = 0; index < changeInfoArr.length; index++) {
+                final PacketPlayOutMultiBlockChange.MultiBlockChangeInfo info = changeInfoArr[index];
+                final IBlockData modified = modifyBlockData(settings, info.c());
+                if (modified == info.c()) {
+                    continue;
+                }
+
+                if (changeInfoList == null) {
+                    changeInfoList = new ArrayList<>(Arrays.asList(changeInfoArr));
+                }
+
+                final int relativeIndex = index - changes;
+                if (modified == null) {
+                    changeInfoList.remove(relativeIndex);
+                    changes++;
+                } else {
+                    changeInfoList.set(relativeIndex, bc.createMultiChangeInfo(info.b(), modified));
+                }
+            }
+
+            if (changeInfoList != null) {
+                return new PacketPlayOutMultiBlockChange(bc.getChunkCoordIntPair(), changeInfoList.toArray(new PacketPlayOutMultiBlockChange.MultiBlockChangeInfo[0]));
+            }
+        } else if (packet instanceof PacketPlayOutMapChunk) {
+            final PacketPlayOutMapChunk mc = (PacketPlayOutMapChunk) packet;
+            if (!mc.dirtyUpdate) {
+                return packet;
+            }
+
+            final PacketPlayOutMapChunk.ChunkMap chunkMap = mc.getChunkMap();
+            final PacketPlayOutMapChunk.ChunkMap modified = modifyChunkMap(settings, chunkMap, mc.skyLight);
+            if (modified != chunkMap) {
+                return new PacketPlayOutMapChunk(modified.a, modified.b, mc.getX(), mc.getZ(), mc.isUnloading());
+            }
+        } else if (packet instanceof PacketPlayOutMapChunkBulk) {
+            final PacketPlayOutMapChunkBulk mc = (PacketPlayOutMapChunkBulk) packet;
+            PacketPlayOutMapChunk.ChunkMap[] chunks = mc.getChunkMaps();
+
+            for (int i = 0; i < chunks.length; i++) {
+                final PacketPlayOutMapChunk.ChunkMap chunkMap = chunks[i];
+                final PacketPlayOutMapChunk.ChunkMap modified = modifyChunkMap(settings, chunkMap, mc.hasSkyLight());
+                if (modified == chunkMap) {
+                    continue;
+                }
+
+                if (chunks == mc.getChunkMaps()) {
+                    chunks = Arrays.copyOf(chunks, chunks.length);
+                }
+
+                chunks[i] = modified;
+            }
+
+            if (chunks != mc.getChunkMaps()) {
+                return new PacketPlayOutMapChunkBulk(mc.getXArr(), mc.getZArr(), chunks, mc.hasSkyLight(), mc.getWorld());
+            }
+        } else if (packet instanceof PacketPlayOutTileEntityData && settings.isToggled(me.samsuik.blossom.visuals.Visuals.VisualType.SPAWNERS)) {
+            final PacketPlayOutTileEntityData te = (PacketPlayOutTileEntityData) packet;
+            if (te.getId() == 1) {
+                return new PacketPlayOutBlockChange(SPAWNER_CONVERSION_BLOCK, te.getPosition());
+            }
+        } else if (packet instanceof PacketPlayOutBlockAction && settings.isToggled(me.samsuik.blossom.visuals.Visuals.VisualType.PISTONS)) {
+            final PacketPlayOutBlockAction ba = (PacketPlayOutBlockAction) packet;
+            if (isPiston(ba.getBlock())) {
+                return null;
+            }
+        }
+
+        return packet;
+    }
+
+    private static PacketPlayOutMapChunk.ChunkMap modifyChunkMap(final VisualSettings settings, final PacketPlayOutMapChunk.ChunkMap chunkMap, final boolean skyLight) {
+        byte[] data = chunkMap.a;
+        final int bitmap =  chunkMap.b;
+        final int height = Integer.bitCount(bitmap & '\uffff');
+
+        int blocks = height * 16 * 16 * 16 * 2;
+        int light  = height * 16 * 16 * 16 / 2;
+
+        if (skyLight) {
+            light *= 2;
+        }
+
+        if (settings.isToggled(me.samsuik.blossom.visuals.Visuals.VisualType.SPAWNERS)) {
+            for (int index = 0; index < blocks; index += 2) {
+                int combined = (data[index] & 255) | (data[index + 1] & 255) << 8;
+                final IBlockData iblockdata = Block.d.a(combined);
+                if (iblockdata == null) {
+                    continue;
+                }
+
+                final IBlockData modified = modifyBlockData(settings, iblockdata);
+                if (modified == iblockdata || modified == null) {
+                    continue;
+                }
+
+                if (data == chunkMap.a) {
+                    data = Arrays.copyOf(data, data.length);
+                }
+
+                combined = Block.d.b(iblockdata);
+
+                data[index + 0] = (byte) (combined & 255);
+                data[index + 1] = (byte) (combined >> 8 & 255);
+            }
+        }
+
+        if (settings.isToggled(me.samsuik.blossom.visuals.Visuals.VisualType.LIGHTING)) {
+            if (data == chunkMap.a) {
+                data = Arrays.copyOf(data, data.length);
+            }
+
+            final int end = light + blocks;
+            for (int index = blocks; index < end; ++index) {
+                data[index] = -1;
+            }
+        }
+
+        if (data != chunkMap.a) {
+            final PacketPlayOutMapChunk.ChunkMap reconstructedMap = new PacketPlayOutMapChunk.ChunkMap();
+            reconstructedMap.a = data;
+            reconstructedMap.b = bitmap;
+            return reconstructedMap;
+        }
+
+        return chunkMap;
+    }
+
+    private static IBlockData modifyBlockData(final VisualSettings settings, final IBlockData iblockdata) {
+        final Block block = iblockdata.getBlock();
+        if (settings.isToggled(me.samsuik.blossom.visuals.Visuals.VisualType.REDSTONE) && (block instanceof BlockRedstoneWire || block instanceof BlockDiodeAbstract)) {
+            return null;
+        } else if (settings.isToggled(me.samsuik.blossom.visuals.Visuals.VisualType.PISTONS) && isPiston(block)) {
+            return null;
+        } else if (settings.isToggled(me.samsuik.blossom.visuals.Visuals.VisualType.SPAWNERS) && (block instanceof BlockMobSpawner)) {
+            return SPAWNER_CONVERSION_BLOCK;
+        }
+
+        return iblockdata;
+    }
+
+    private static boolean isPiston(final Block block) {
+        return block instanceof BlockPiston || block instanceof BlockPistonExtension || block instanceof BlockPistonMoving;
+    }
+}
diff --git a/src/main/java/me/samsuik/blossom/player/visibility/VisualSettings.java b/src/main/java/me/samsuik/blossom/player/visibility/VisualSettings.java
