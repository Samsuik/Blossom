+package me.samsuik.blossom.commands.subcommands;
+
+import me.samsuik.blossom.commands.BaseCommand;
+import me.samsuik.blossom.configuration.BlossomConfig;
+import me.samsuik.blossom.util.MessageUtil;
+import me.samsuik.blossom.visuals.Visuals;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+
+import java.util.Arrays;
+import java.util.Locale;
+
+public final class VisualCommand extends BaseCommand {
+    private final Visuals.VisualType type;
+
+    public VisualCommand(final Visuals.VisualType type, final String... aliases) {
+        super(type.name().toLowerCase(Locale.ENGLISH).replace("_", ""));
+        this.setAliases(Arrays.asList(aliases));
+        this.type = type;
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String label, final String[] args) {
+        if (!(sender instanceof Player)) {
+            return true;
+        } else if (!this.testPermission(sender)) {
+            return true;
+        }
+
+        final Player player = (Player) sender;
+        final Visuals viusals = player.getVisuals();
+        viusals.toggle(type);
+
+        final String state = viusals.isEnabled(type) ? "Enabled" : "Disabled";
+        sender.sendMessage(MessageUtil.format(BlossomConfig.fpsSettingChange, "state", state, "name", type.getFriendlyName()));
+        return true;
+    }
+}
