diff --git a/src/main/java/me/samsuik/blossom/commands/subcommands/DebugCommand.java b/src/main/java/me/samsuik/blossom/commands/subcommands/DebugCommand.java
new file mode 100644
index 000000000..377cddddb
--- /dev/null
+++ b/src/main/java/me/samsuik/blossom/commands/subcommands/DebugCommand.java
@@ -0,0 +1,52 @@
+package me.samsuik.blossom.commands.subcommands;
+
+import me.samsuik.blossom.commands.BaseCommand;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.WorldServer;
+import org.bukkit.command.CommandSender;
+
+import java.util.Arrays;
+import java.util.List;
+
+public final class DebugCommand extends BaseCommand {
+    private static final List<String> PARAMETERS = Arrays.asList("dump", "reset");
+
+    public DebugCommand() {
+        super("debug");
+        this.setPermission("blossom.debug");
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String alias, final String[] args) {
+        if (args.length == 0 || !PARAMETERS.contains(args[0])) {
+            return false;
+        }
+
+        final boolean reset = args[0].equals("reset");
+        final StringBuilder info = new StringBuilder();
+
+        for (final WorldServer world : MinecraftServer.getServer().worlds) {
+            final String name = world.getWorld().getName();
+            if (args.length >= 2 && !name.equals(args[1])) {
+                continue;
+            }
+
+            final String action = reset ? "Reset" : "Dumped";
+            info.append(action + " World: \"" + name + "\"\n");
+
+            if (reset) {
+                world.resetTickingState();
+            } else {
+                world.dumpTickingState(info);
+            }
+        }
+
+        sender.sendMessage(info.toString());
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(final CommandSender sender, final String alias, final String[] args) throws IllegalArgumentException {
+        return PARAMETERS;
+    }
+}
