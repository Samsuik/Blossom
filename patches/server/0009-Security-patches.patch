+package me.samsuik.blossom.network.nbt;
+
+import io.netty.buffer.ByteBufInputStream;
+import net.minecraft.server.*;
+import org.bukkit.craftbukkit.inventory.CraftItemStack;
+import org.spigotmc.LimitStream;
+
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.IOException;
+
+public final class ItemNbtReader {
+    public static ItemStack readItemStackUntrusted(final PacketDataSerializer serializer, final long bytes) throws IOException {
+        final short itemId = serializer.readShort();
+        if (itemId < 0) {
+            return null;
+        }
+
+        final Item item = Item.getById(itemId);
+        if (item == null) {
+            return new ItemStack((Item) null, 1);
+        }
+
+        final byte count = serializer.readByte();
+        final short damage = serializer.readShort();
+        final ItemStack stack = new ItemStack(item, count, damage);
+
+        final NBTTagCompound component = readNbtTag(serializer, bytes);
+        if (component != null && !component.isEmpty()) {
+            stack.setTag(component);
+            CraftItemStack.setItemMeta(stack, CraftItemStack.getItemMeta(stack));
+        }
+
+        return stack;
+    }
+
+    private static NBTTagCompound readNbtTag(final PacketDataSerializer serializer, final long bytes) throws IOException {
+        final int index = serializer.readerIndex();
+        try {
+            return serializer.readNbtComponent(bytes);
+        } catch (final NbtByteLimitException byteLimitException) {
+            serializer.readerIndex(index);
+            try {
+                return readRootComponents(serializer, new NBTReadLimiter(bytes), false);
+            } catch (final NbtByteLimitException nbtByteLimitException) {
+                return new NBTTagCompound();
+            }
+        }
+    }
+
+    private static NBTTagCompound readRootComponents(final PacketDataSerializer serializer, final NBTReadLimiter limiter, final boolean named) throws IOException {
+        final DataInput input = new DataInputStream(new LimitStream(new ByteBufInputStream(serializer), limiter));
+        final byte type = input.readByte();
+        if (type != 10) {
+            throw new IOException("Root tag must be a compound tag");
+        }
+
+        final String name = input.readUTF();
+        if (!named && !name.isEmpty()) {
+            throw new IOException("Unexpected root tag name");
+        }
+
+        final NBTTagCompound rootComponent = new NBTTagCompound();
+        try {
+            rootComponent.loadRootComponents(input, limiter);
+            return rootComponent;
+        } catch (final IOException e) {
+            throw new IOException("Something went wrong while reading nbt", e);
+        }
+    }
+}
