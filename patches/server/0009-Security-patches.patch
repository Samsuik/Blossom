+package me.samsuik.blossom.util;
+
+import net.minecraft.server.SharedConstants;
+
+public final class SanitizeCharacters {
+    private static boolean isAllowedCharacter(final char charCode) {
+        return SharedConstants.isAllowedChatCharacter(charCode) && charCode < 256;
+    }
+
+    public static String stripDisallowedCharacters(final String string) {
+        final StringBuilder builder = new StringBuilder();
+        for (final char charCode : string.toCharArray()) {
+            if (isAllowedCharacter(charCode)) {
+                builder.append(charCode);
+            }
+        }
+
+        return builder.toString();
+    }
+}
