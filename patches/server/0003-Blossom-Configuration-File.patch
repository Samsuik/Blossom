+package me.samsuik.blossom.util;
+
+import org.bukkit.Material;
+import org.bukkit.inventory.ItemStack;
+
+import java.util.*;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+public final class ModernMaterial {
+    private final Material material;
+    private final int data;
+
+    public static int getData(final String materialName) {
+        return getMaterial(materialName).getData();
+    }
+
+    public static ModernMaterial getMaterial(final String materialName) {
+        final Matcher extracted = DataMapping.DATA_PATTERN.matcher(materialName);
+        if (extracted.find()) {
+            final int data = DataMapping.MATERIAL_DATA.getOrDefault(extracted.group(1), 0);
+            final String legacyMaterial = extracted.group(2);
+            return new ModernMaterial(Material.getMaterial(legacyMaterial), data);
+        } else {
+            return new ModernMaterial(Material.getMaterial(materialName), 0);
+        }
+    }
+
+    public ModernMaterial(final Material material, final int data) {
+        this.material = material;
+        this.data = data;
+    }
+
+    public Material getMaterial() {
+        return this.material;
+    }
+
+    public int getData() {
+        return this.data;
+    }
+
+    public ItemStack createItem(final int count) {
+        return new ItemStack(this.material, count, (short) this.data);
+    }
+
+    @Override
+    public boolean equals(final Object o) {
+        if (!(o instanceof ModernMaterial)) return false;
+        final ModernMaterial that = (ModernMaterial) o;
+        return data == that.data && material == that.material;
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(material, data);
+    }
+
+    @Override
+    public String toString() {
+        return "ModernMaterial{" +
+                "material=" + material +
+                ", data=" + data +
+                '}';
+    }
+
+    private static final class DataMapping {
+        private static final List<String> COLORS;
+        private static final Map<String, Integer> MATERIAL_DATA = new HashMap<>();
+        private static final Pattern DATA_PATTERN;
+
+        static {
+            COLORS = Arrays.asList(
+                "WHITE", "ORANGE", "MAGENTA", "LIGHT_BLUE", "YELLOW", "LIME", "PINK", "GRAY", "LIGHT_GRAY", "CYAN", "PURPLE", "BLUE", "BROWN", "GREEN", "RED", "BLACK"
+            );
+
+            for (int index = 0; index < COLORS.size(); index++) {
+                MATERIAL_DATA.put(COLORS.get(index), index);
+            }
+
+            final StringBuilder builder = new StringBuilder();
+            for (final String color : COLORS) {
+                if (builder.length() > 0) {
+                    builder.append('|');
+                }
+                builder.append(color);
+            }
+
+            DATA_PATTERN = Pattern.compile("^(" + builder.toString() + ")_(.+)");
+        }
+    }
+}
