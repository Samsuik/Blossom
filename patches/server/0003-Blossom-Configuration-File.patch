@@ -0,0 +1,39 @@
+package me.samsuik.blossom.util;
+
+import org.bukkit.ChatColor;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+public final class MessageUtil {
+    private static final Pattern TAG_PATTERN = Pattern.compile("%([^%]+)?%?");
+
+    public static String format(String message, final Object... args) {
+        final Map<String, String> placeholders = new HashMap<>();
+        for (int index = 0; index < args.length; index += 2) {
+            placeholders.put(args[index].toString(), args[index + 1].toString());
+        }
+
+        final Matcher tagMatcher = TAG_PATTERN.matcher(message);
+        while (tagMatcher.find()) {
+            final String tag = tagMatcher.group(1);
+            final String[] parts = tag.split("\\$");
+
+            String placeholder = placeholders.get(parts[0]);
+            for (int i = 1; i < parts.length; i++) {
+                final String part = parts[i];
+                final String[] replacement = part.split("=");
+
+                if (replacement.length == 2) {
+                    placeholder = placeholder.replaceAll(replacement[0], replacement[1]);
+                }
+            }
+
+            message = message.replace("%" + tag + "%", placeholder);
+        }
+
+        return ChatColor.translateAlternateColorCodes('&', message);
+    }
+}
