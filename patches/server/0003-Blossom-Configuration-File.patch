+package me.samsuik.blossom.configuration;
+
+import java.util.List;
+
+import org.bukkit.Bukkit;
+import org.bukkit.configuration.file.YamlConfiguration;
+
+public final class BlossomWorldConfig {
+
+    private final String worldName;
+    private final YamlConfiguration config;
+
+    public BlossomWorldConfig(final String worldName) {
+        this.worldName = worldName;
+        this.config = BlossomConfig.config;
+        this.init();
+    }
+
+    public void init() {
+        BlossomConfig.readConfig(BlossomWorldConfig.class, this);
+    }
+
+    private void set(final String path, final Object val) {
+        this.config.set(path, val);
+    }
+
+    private void remove(final String path) {
+        set(path, null);
+    }
+
+    private String path(final String path) {
+        return "world-settings." + this.worldName + "." + path;
+    }
+
+    private boolean getBoolean(final String path, final boolean def) {
+        this.config.addDefault(path, def);
+        return this.config.getBoolean(this.path(path), this.config.getBoolean(path));
+    }
+
+    private double getDouble(final String path, final double def) {
+        this.config.addDefault(path, def);
+        return this.config.getDouble(this.path(path), this.config.getDouble(path));
+    }
+
+    private int getInt(final String path, final int def) {
+        this.config.addDefault(path, def);
+        return this.config.getInt(this.path(path), this.config.getInt(path));
+    }
+
+    private <T extends List<?>> T getList(final String path, final T def) {
+        this.config.addDefault(path, def);
+        return (T) this.config.getList(this.path(path), this.config.getList(path));
+    }
+
+    private String getString(final String path, final String def) {
+        this.config.addDefault(path, def);
+        return this.config.getString(this.path(path), this.config.getString(path));
+    }
+
+    private void remove() {
+    }
+
+}
